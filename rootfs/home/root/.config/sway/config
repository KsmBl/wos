# Default configuration for sway on WOS.
#
# This is read when a user has no ~/.config/sway/config of their own.  Copy it
# there and edit it -- `swaymsg reload` rereads it without restarting anything:
#
#     mkdir -p ~/.config/sway
#     cp /etc/sway/config ~/.config/sway/config
#
# The language is sway's, so the sway documentation applies.  Every line is a
# command, and the same commands work at runtime through swaymsg -- `bindsym
# $mod+Return exec wlterm` binds a key to exactly what `swaymsg exec wlterm`
# would do.

### Variables

# Your modifier key.  Mod1 is Alt and Mod4 is the Super key, which is what sway
# uses by default and what this does: it leaves Alt to the programs.
set $mod Mod4

# The directions, so the movement bindings read like the keyboard looks.
set $left  h
set $down  j
set $up    k
set $right l

# The terminal emulator this opens.
set $term wlterm

### Output

# One screen, at whatever size the console was using.  Its resolution cannot be
# changed from here -- the framebuffer is the one the kernel brought up -- so
# the background is the only output setting that does anything.
output * bg #101820 solid_color

### Input

# How far the pointer moves for how far the mouse does, on sway's scale: -1 is
# as slow as it goes, 0 leaves the mouse's counts alone at one to one, and 1 is
# four times them.  Anything between works -- `pointer_accel 0.5` is half way
# up.  Takes effect the moment it is read, so `swaymsg 'input * pointer_accel
# 0.5'` is how to find the number you want before writing it down here.
#
# There is one pointer, the one the kernel found, so the identifier selects
# nothing: it is read and dropped, and any name does.  The block form real sway
# configurations use works too, and means the same thing:
#
#     input "type:pointer" {
#         pointer_accel 0.5
#     }
input * pointer_accel 0

### Cursor

# The pointer's size and colour.  Neither is a sway setting: there the cursor
# comes from an X cursor theme, which is a directory of images and a loader for
# them.  Here it is a shape the compositor draws, so it is a whole-number scale
# (1 to 4) and the colour the inside of the arrow is filled with.  The outline
# stays black at every size, which is what makes a white arrow visible on a
# white window.
#
# `seat * xcursor_theme <theme> <size>` from a real sway configuration is read
# too: the theme is dropped and the size is kept, rounded to the nearest scale.
cursor size 1
cursor color #ffffff

### The desktop

# What is written across the background -- which is what an empty workspace
# shows.  ${CPU} and ${MEM} are replaced with the live figures as they change,
# `\n` starts another line, and empty means the key hints a fresh machine has:
#
#     background_text "WOS\ncpu ${CPU}   mem ${MEM}"
#
# swaysettings has a field for this, and writes it back here.
background_text ""

### Key bindings

# Programs
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

# The settings window: the background colour, the mouse speed and where the bar
# sits, with the value visible while it changes.  Save writes them back here.
bindsym $mod+Shift+s exec swaysettings

# The launcher: every program in /app, by typing part of its name.  Enter runs
# the one that is selected -- in a window if it draws one, in a terminal if it
# prints -- and the window goes away as soon as it has.
bindsym $mod+q exec wauncher

# Moving the focus, in the vi directions and with the arrow keys
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Moving the window itself
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Where the next window goes: beside this one, or below it
bindsym $mod+b splith
bindsym $mod+v splitv

# Rearrange the windows already here
bindsym $mod+e layout toggle
bindsym $mod+f fullscreen

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

### Appearance

# A title bar and a one pixel border.  `default_border pixel 1` drops the title
# bar; `default_border none` drops both, which on a 640x400 screen is worth
# considering.
default_border normal

# border  background  text     indicator  child_border
client.focused   #4c7899 #285577 #ffffff #2e9ef4 #285577
client.unfocused #333333 #222222 #888888 #292d2e #222222

# Gaps between the windows, and around the edge of the screen.
gaps inner 0
gaps outer 0

### The bar

# Across the top, drawn by the compositor.  `mode hide` takes its twenty pixels
# back and shows it over the windows while $mod is held; `status_text` is the
# right-hand side, with the same ${...} names the background text takes.
bar {
    position top
    mode dock
    status_text ""
}

### Things this compositor has not got
#
# Each of these is read and ignored, and says so in /ramdisk/sway.log:
#
#   font              one 8x16 font is built in and cannot be changed
#   floating_modifier nothing floats -- every window tiles, and a floating one
#                     would need a stacking order the layout tree has not got
#   accel_profile     the pointer is flat by nature: speed is a multiplier,
#                     and a curve would need timing a PS/2 mouse cannot give
#   input <anything>  other than pointer_accel: the keyboard is the one the
#                     kernel found, with no settings to change
#   seat              there is one seat, and it is the compositor's
#   status_command    no program is run for the bar: `bar status_text "..."`
#                     takes ${CPU}, ${MEM}, ${TIME}, ${DATE} and ${BATTERY}
#   swaybar           the bar is drawn by the compositor rather than by a
#                     client: a bar as a client would need layer-shell, and a
#                     window that tiles is not a bar
